# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB - server only
MONGODB_URI=mongodb://127.0.0.1:27017/expenseflow

# Authentication - server only
AUTH_SECRET=expenseflow_foundation_super_secret_jwt_key_at_least_32_characters

# Email - server only
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secret
EMAIL_FROM=ExpenseFlow <noreply@expenseflow.app>

# Optional rate limit store
REDIS_URL=

# Optional monitoring
SENTRY_DSN=

# Internal scheduled jobs - server only
CRON_SECRET=internal_cron_secret_key_32_characters

# Future receipt storage - server only
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
