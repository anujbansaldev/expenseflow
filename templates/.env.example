# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB - server only
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/expenseflow?retryWrites=true&w=majority

# Authentication - server only
AUTH_SECRET=replace-with-a-long-random-secret

# Email - server only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional rate limit store
REDIS_URL=

# Optional monitoring
SENTRY_DSN=

# Internal scheduled jobs - server only
CRON_SECRET=

# Future receipt storage - server only
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
